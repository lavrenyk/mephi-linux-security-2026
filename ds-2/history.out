   48  cat shadow 
   49  sudo chmod +r shadow
   50  clear
   51  sudo usermod -u 5501 user1
   52  sudo usermod -aG students user1
   53  sudo usermod -aG students user2
   54  sudo usermod -aG students user3
   55  id user1
   56  id user2
   57  id user3
   58  getent group user1
   59  getent group 5501
   60  sudo groupadd -g 5501 user1
   61  sudo usermod -g user1 -aG students user1
   62  id user1
   63  sudo find /home /data /mephi-web -uid 1234 -ls
   64  sudo dnf install -y acl
   65  sudo getfacl -R -p /data/mephi-2026 > ~/acl-before.out
   66  sudo chown root:students /data/mephi-2026
   67  sudo find /data/mephi-2026 -type d -exec chgrp students {} +
   68  sudo find /data/mephi-2026 -type f -exec chgrp students {} +
   69  sudo find /data/mephi-2026 -type d -exec chmod g+s {} +
   70  sudo find /data/mephi-2026 -type d -exec   setfacl --set 'u::rwx,g::rwx,g:curators:r-x,m::rwx,o::---' {} +
   71  sudo find /data/mephi-2026 -type f -exec   setfacl --set 'u::rw-,g::rw-,g:curators:r--,m::rw-,o::---' {} +
   72  sudo find /data/mephi-2026 -type d -exec   setfacl -d --set 'u::rwx,g::rwx,g:curators:r-x,m::rwx,o::---' {} +
   73  sudo -u user1 mkdir /data/mephi-2026/access-check
   74  for creator in user1 user2 user3; do   sudo -u "$creator" sh -c     'echo created > "/data/mephi-2026/access-check/$1.txt"' sh "$creator"; done
   75  for developer in user1 user2 user3; do   for creator in user1 user2 user3; do     sudo -u "$developer" cat       "/data/mephi-2026/access-check/$creator.txt";      sudo -u "$developer" sh -c       'echo updated >> "/data/mephi-2026/access-check/$1.txt"' sh "$creator";   done; done
   76  for curator in curator1 curator2; do   sudo -u "$curator" cat /data/mephi-2026/access-check/user1.txt;    sudo -u "$curator" sh -c     'echo forbidden >> /data/mephi-2026/access-check/user1.txt';    sudo -u "$curator" rm /data/mephi-2026/access-check/user1.txt; done
